<?xml version="1.0" encoding="utf-8"?>
<!--
   Explicit backup exclusions for SKYPLUS MONEY encrypted database and key-wrapping vault.
   android:allowBackup="false" is also enforced in AndroidManifest.xml.
-->
<full-backup-content>
    <exclude domain="database" path="skyplus_money_encrypted.db" />
    <exclude domain="database" path="skyplus_money_encrypted.db-wal" />
    <exclude domain="database" path="skyplus_money_encrypted.db-shm" />
    <exclude domain="database" path="skyplus_money_encrypted.db-journal" />
    <exclude domain="sharedpref" path="skyplus_db_secure_vault.xml" />
    <exclude domain="file" path="datastore/skyplus_detection_settings.preferences_pb" />
</full-backup-content>
